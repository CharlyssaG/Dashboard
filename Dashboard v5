<style>
*{box-sizing:border-box;margin:0;padding:0;}
.hq{padding:1rem 0;font-family:var(--font-sans);}
.hq-banner{display:flex;align-items:center;gap:10px;padding:14px 18px;background:linear-gradient(180deg,#FFF8E7 0%,#FFEAB6 100%);border-radius:14px;margin-bottom:1.25rem;border:1px solid #F5D67A;}
.hq-dot{width:10px;height:10px;border-radius:50%;background:#FFC940;box-shadow:0 0 8px #FFC940;animation:pulse 2s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:.5;transform:scale(1);}50%{opacity:1;transform:scale(1.2);}}
.hq-title{font-size:13px;letter-spacing:.18em;color:#7A4C00;font-weight:500;text-transform:uppercase;}
.hq-status{font-size:12px;color:#5C3A00;margin-left:auto;}

.console{background:linear-gradient(180deg,#2A2D3E 0%,#1F2230 100%);border-radius:18px;padding:1.5rem;margin-bottom:1.5rem;position:relative;overflow:hidden;box-shadow:inset 0 1px 0 rgba(255,255,255,0.1),0 4px 20px rgba(0,0,0,0.15);}
.console::before{content:"";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.3),transparent);}
.console-screen{display:flex;align-items:center;gap:1.5rem;}
.screen-img-wrap{width:160px;height:160px;flex-shrink:0;background:radial-gradient(circle,#3A3F58 0%,#1A1D2A 100%);border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid var(--ring,#5A5F78);box-shadow:0 0 0 4px rgba(0,0,0,0.3),0 0 30px var(--glow,rgba(255,255,255,0.05));transition:all 0.3s ease;}
.screen-img-wrap.lit{box-shadow:0 0 0 4px rgba(0,0,0,0.3),0 0 40px var(--glow);}
.screen-img-wrap img{width:130px;height:130px;object-fit:contain;border-radius:50%;}
.screen-empty{width:130px;height:130px;display:flex;align-items:center;justify-content:center;font-size:11px;color:#7A8099;text-align:center;letter-spacing:.1em;text-transform:uppercase;}
.screen-info{flex:1;color:#E8EAF0;}
.screen-eyebrow{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#9CA0B5;margin-bottom:6px;}
.screen-name{font-size:26px;font-weight:500;color:#FFFFFF;margin-bottom:2px;letter-spacing:-0.01em;}
.screen-fam{font-size:13px;color:var(--fam-color,#9CA0B5);margin-bottom:14px;font-weight:500;letter-spacing:.05em;}

.gauge{margin-top:8px;}
.gauge-label-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.gauge-label{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#9CA0B5;}
.gauge-value{font-size:18px;font-weight:500;color:#FFFFFF;}
.gauge-track{height:6px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden;position:relative;}
.gauge-fill{height:100%;width:50%;background:linear-gradient(90deg,var(--fam-color,#5A5F78),var(--fam-glow,#FFFFFF));border-radius:3px;transition:width .2s ease,background .3s ease;box-shadow:0 0 10px var(--fam-color,transparent);}
input[type="range"].drive{width:100%;margin-top:10px;background:transparent;-webkit-appearance:none;appearance:none;}
input[type="range"].drive::-webkit-slider-runnable-track{height:6px;background:rgba(255,255,255,0.05);border-radius:3px;}
input[type="range"].drive::-moz-range-track{height:6px;background:rgba(255,255,255,0.05);border-radius:3px;}
input[type="range"].drive::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;height:18px;width:18px;border-radius:50%;background:#FFF;border:2px solid var(--fam-color,#5A5F78);cursor:pointer;margin-top:-6px;box-shadow:0 0 8px var(--fam-color,rgba(0,0,0,0.3));}
input[type="range"].drive::-moz-range-thumb{height:18px;width:18px;border-radius:50%;background:#FFF;border:2px solid var(--fam-color,#5A5F78);cursor:pointer;}

.antenna-pips-row{display:flex;align-items:center;gap:10px;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.08);}
.antenna-label{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#9CA0B5;}
.pips{display:flex;gap:6px;margin-left:auto;}
.pip{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,0.1);transition:all .2s;}
.pip.on{background:var(--fam-color,#FFF);box-shadow:0 0 8px var(--fam-color,#FFF);}

.section-bar{display:flex;align-items:center;gap:10px;margin:1.5rem 0 .9rem;}
.section-line{flex:1;height:1px;background:var(--color-border-tertiary);}
.section-label{font-size:11px;letter-spacing:.2em;color:var(--color-text-tertiary);text-transform:uppercase;font-weight:500;}

.fblock{margin-bottom:18px;}
.fname-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.fname{font-size:11px;font-weight:500;padding:3px 10px;border-radius:12px;letter-spacing:.05em;text-transform:uppercase;}
.fcount{font-size:11px;color:var(--color-text-tertiary);}
.chips{display:flex;flex-wrap:wrap;gap:10px;}
.chip{font-size:13px;font-weight:500;padding:9px 18px;border-radius:24px;cursor:pointer;user-select:none;position:relative;letter-spacing:.01em;border:none;background:var(--chip-bg);color:var(--chip-txt);box-shadow:0 4px 0 var(--chip-shadow),0 5px 8px rgba(0,0,0,0.12),inset 0 1px 0 rgba(255,255,255,0.4);transition:transform .08s ease,box-shadow .08s ease;transform:translateY(0);}
.chip:hover{transform:translateY(-2px);box-shadow:0 6px 0 var(--chip-shadow),0 8px 12px rgba(0,0,0,0.15),inset 0 1px 0 rgba(255,255,255,0.4);}
.chip:active,.chip.active{transform:translateY(3px);box-shadow:0 1px 0 var(--chip-shadow),0 2px 4px rgba(0,0,0,0.15),inset 0 1px 2px rgba(0,0,0,0.1);}
.chip.active{background:var(--chip-active);color:white;text-shadow:0 1px 2px rgba(0,0,0,0.2);}
.chip.active::after{content:"";position:absolute;inset:-3px;border-radius:27px;border:2px solid var(--chip-active);opacity:0.4;pointer-events:none;animation:btnGlow 1.5s ease-in-out infinite;}
@keyframes btnGlow{0%,100%{opacity:0.3;transform:scale(1);}50%{opacity:0.6;transform:scale(1.03);}}

.memory-row{display:flex;gap:10px;margin-bottom:1.25rem;align-items:stretch;}
.memory-input{flex:1;font-size:14px;padding:10px 14px;border:1px solid var(--color-border-tertiary);border-radius:24px;background:var(--color-background-primary);color:var(--color-text-primary);transition:border-color .15s;}
.memory-input:focus{outline:none;border-color:var(--color-border-secondary);}
.memory-input::placeholder{color:var(--color-text-tertiary);font-style:italic;}
.log-btn{font-size:13px;padding:8px 22px;border:none;border-radius:24px;background:linear-gradient(180deg,#3A3F58,#1F2230);color:#FFF;cursor:pointer;font-weight:500;letter-spacing:.05em;text-transform:uppercase;box-shadow:0 2px 6px rgba(0,0,0,0.15);transition:all .15s;}
.log-btn:hover{transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,0.2);}
.log-btn:active{transform:translateY(0);}

.log-list{display:flex;flex-direction:column;gap:10px;}
.memory-orb{display:flex;align-items:center;gap:12px;background:var(--color-background-primary);border:1px solid var(--color-border-tertiary);border-radius:14px;padding:10px 14px;position:relative;overflow:hidden;}
.memory-orb::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--orb-color,#888);}
.orb-thumb-wrap{width:50px;height:50px;flex-shrink:0;background:radial-gradient(circle,var(--orb-bg,#F0F0F0) 0%,var(--orb-shadow,#D0D0D0) 100%);border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid var(--orb-color,#888);}
.orb-thumb{width:42px;height:42px;object-fit:contain;border-radius:50%;}
.orb-body{flex:1;}
.orb-top{display:flex;align-items:center;gap:8px;margin-bottom:3px;}
.orb-name{font-size:14px;font-weight:500;color:var(--color-text-primary);}
.orb-int{font-size:11px;color:var(--color-text-tertiary);background:var(--color-background-secondary);padding:2px 8px;border-radius:10px;}
.orb-time{font-size:11px;color:var(--color-text-tertiary);margin-left:auto;letter-spacing:.05em;}
.orb-note{font-size:13px;color:var(--color-text-secondary);font-style:italic;}
.empty-log{text-align:center;padding:2rem 1rem;font-size:13px;color:var(--color-text-tertiary);font-style:italic;}
.empty-log::before{content:"·  ·  ·";display:block;font-size:18px;letter-spacing:.5em;margin-bottom:8px;color:var(--color-border-secondary);font-style:normal;}
</style>

<div class="hq">
<h2 class="sr-only">Headquarters emotion dashboard with custom orb characters</h2>

<div class="hq-banner">
  <div class="hq-dot"></div>
  <div class="hq-title">Headquarters · Live</div>
  <div class="hq-status" id="hq-status">Awaiting input</div>
</div>

<div class="console" id="console">
  <div class="console-screen">
    <div class="screen-img-wrap" id="screen-wrap">
      <div class="screen-empty" id="screen-empty">No one<br>at the<br>wheel</div>
      <img id="preview-img" src="" style="display:none;"/>
    </div>
    <div class="screen-info">
      <div class="screen-eyebrow">Now Driving</div>
      <div class="screen-name" id="preview-name">—</div>
      <div class="screen-fam" id="preview-fam">tap a feeling below</div>
      <div class="gauge">
        <div class="gauge-label-row">
          <span class="gauge-label">Drive Level</span>
          <span class="gauge-value" id="int-val">5</span>
        </div>
        <div class="gauge-track"><div class="gauge-fill" id="gauge-fill"></div></div>
        <input type="range" class="drive" min="1" max="10" step="1" value="5" id="intensity">
      </div>
      <div class="antenna-pips-row">
        <span class="antenna-label">Intensity Antennae</span>
        <div class="pips">
          <div class="pip" id="p0"></div>
          <div class="pip" id="p1"></div>
          <div class="pip" id="p2"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="section-bar">
  <span class="section-label">Who\'s at the wheel?</span>
  <div class="section-line"></div>
</div>
<div id="families"></div>

<div class="section-bar">
  <span class="section-label">Drop a memory</span>
  <div class="section-line"></div>
</div>
<div class="memory-row">
  <input type="text" id="note" class="memory-input" placeholder="A breadcrumb for future you (optional)" maxlength="120">
  <button class="log-btn" onclick="logIt()">Save</button>
</div>

<div class="section-bar">
  <span class="section-label">Today\'s memories</span>
  <div class="section-line"></div>
</div>
<div class="log-list" id="log-list">
  <div class="empty-log">No memories saved yet today.</div>
</div>
</div>

<script>
var EMOTIONS = [{"id": "frustrated", "label": "Frustrated", "family": "Angry", "fc": "#E24B4A", "fbg": "#FCEBEB", "ftxt": "#791F1F", "img": "data:image/png;base64,"}, {"id": "irritated", "label": "Irritated", "family": "Angry", "fc": "#E24B4A", "fbg": "#FCEBEB", "ftxt": "#791F1F", "img": "data:image/png;base64,"}, {"id": "overwhelmed", "label": "Overwhelmed", "family": "Angry", "fc": "#E24B4A", "fbg": "#FCEBEB", "ftxt": "#791F1F", "img": "data:image/png;base64,"}, {"id": "annoyed", "label": "Annoyed", "family": "Angry", "fc": "#E24B4A", "fbg": "#FCEBEB", "ftxt": "#791F1F", "img": "data:image/png;base64,"}, {"id": "lonely", "label": "Lonely", "family": "Sad", "fc": "#534AB7", "fbg": "#EEEDFE", "ftxt": "#3C3489", "img": "data:image/png;base64,"}, {"id": "guilty", "label": "Guilty", "family": "Sad", "fc": "#534AB7", "fbg": "#EEEDFE", "ftxt": "#3C3489", "img": "data:image/png;base64,"}, {"id": "hopeless", "label": "Hopeless", "family": "Sad", "fc": "#534AB7", "fbg": "#EEEDFE", "ftxt": "#3C3489", "img": "data:image/png;base64,"}, {"id": "empty", "label": "Empty", "family": "Sad", "fc": "#534AB7", "fbg": "#EEEDFE", "ftxt": "#3C3489", "img": "data:image/png;base64,"}, {"id": "anxious", "label": "Anxious", "family": "Fear", "fc": "#378ADD", "fbg": "#E6F1FB", "ftxt": "#0C447C", "img": "data:image/png;base64,"}, {"id": "nervous", "label": "Nervous", "family": "Fear", "fc": "#378ADD", "fbg": "#E6F1FB", "ftxt": "#0C447C", "img": "data:image/png;base64,"}, {"id": "worried", "label": "Worried", "family": "Fear", "fc": "#378ADD", "fbg": "#E6F1FB", "ftxt": "#0C447C", "img": "data:image/png;base64,"}, {"id": "vulnerable", "label": "Vulnerable", "family": "Fear", "fc": "#378ADD", "fbg": "#E6F1FB", "ftxt": "#0C447C", "img": "data:image/png;base64,"}, {"id": "contempt", "label": "Contempt", "family": "Disgust", "fc": "#1D9E75", "fbg": "#E1F5EE", "ftxt": "#085041", "img": "data:image/jpeg;base64,"}, {"id": "repelled", "label": "Repelled", "family": "Disgust", "fc": "#1D9E75", "fbg": "#E1F5EE", "ftxt": "#085041", "img": "data:image/png;base64,"}, {"id": "apathetic", "label": "Apathetic", "family": "Disgust", "fc": "#1D9E75", "fbg": "#E1F5EE", "ftxt": "#085041", "img": "data:image/png;base64,"}, {"id": "content", "label": "Content", "family": "Happy", "fc": "#BA7517", "fbg": "#FAEEDA", "ftxt": "#633806", "img": "data:image/png;base64,"}, {"id": "proud", "label": "Proud", "family": "Happy", "fc": "#BA7517", "fbg": "#FAEEDA", "ftxt": "#633806", "img": "data:image/png;base64,"}, {"id": "grateful", "label": "Grateful", "family": "Happy", "fc": "#BA7517", "fbg": "#FAEEDA", "ftxt": "#633806", "img": "data:image/png;base64,"}, {"id": "inspired", "label": "Inspired", "family": "Happy", "fc": "#BA7517", "fbg": "#FAEEDA", "ftxt": "#633806", "img": "data:image/png;base64,"}, {"id": "hopeful", "label": "Hopeful", "family": "Trust", "fc": "#639922", "fbg": "#EAF3DE", "ftxt": "#27500A", "img": "data:image/png;base64,"}, {"id": "valued", "label": "Valued", "family": "Trust", "fc": "#639922", "fbg": "#EAF3DE", "ftxt": "#27500A", "img": "data:image/png;base64,"}, {"id": "calm", "label": "Calm", "family": "Trust", "fc": "#639922", "fbg": "#EAF3DE", "ftxt": "#27500A", "img": "data:image/png;base64,"}, {"id": "accepted", "label": "Accepted", "family": "Trust", "fc": "#639922", "fbg": "#EAF3DE", "ftxt": "#27500A", "img": "data:image/png;base64,"}, {"id": "eager", "label": "Eager", "family": "Anticipation", "fc": "#D85A30", "fbg": "#FAECE7", "ftxt": "#712B13", "img": "data:image/png;base64,"}, {"id": "motivated", "label": "Motivated", "family": "Anticipation", "fc": "#D85A30", "fbg": "#FAECE7", "ftxt": "#712B13", "img": "data:image/png;base64,"}, {"id": "focused", "label": "Focused", "family": "Anticipation", "fc": "#D85A30", "fbg": "#FAECE7", "ftxt": "#712B13", "img": "data:image/png;base64,"}, {"id": "startled", "label": "Startled", "family": "Surprise", "fc": "#D4537E", "fbg": "#FBEAF0", "ftxt": "#72243E", "img": "data:image/png;base64,"}, {"id": "confused", "label": "Confused", "family": "Surprise", "fc": "#D4537E", "fbg": "#FBEAF0", "ftxt": "#72243E", "img": "data:image/png;base64,"}, {"id": "amazed", "label": "Amazed", "family": "Surprise", "fc": "#D4537E", "fbg": "#FBEAF0", "ftxt": "#72243E", "img": "data:image/png;base64,"}, {"id": "pragmatic", "label": "Pragmatic", "family": "Custom", "fc": "#888780", "fbg": "#F1EFE8", "ftxt": "#444441", "img": "data:image/png;base64,"}, {"id": "numb", "label": "Numb", "family": "Custom", "fc": "#888780", "fbg": "#F1EFE8", "ftxt": "#444441", "img": "data:image/png;base64,"}];

var FAMILIES = ['Angry','Sad','Fear','Disgust','Happy','Trust','Anticipation','Surprise','Custom'];
var FAM_STYLE = {
  Angry:{bg:'#FCEBEB',txt:'#791F1F',fc:'#E24B4A',glow:'rgba(226,75,74,0.4)'},
  Sad:{bg:'#EEEDFE',txt:'#3C3489',fc:'#534AB7',glow:'rgba(83,74,183,0.4)'},
  Fear:{bg:'#E6F1FB',txt:'#0C447C',fc:'#378ADD',glow:'rgba(55,138,221,0.4)'},
  Disgust:{bg:'#E1F5EE',txt:'#085041',fc:'#1D9E75',glow:'rgba(29,158,117,0.4)'},
  Happy:{bg:'#FAEEDA',txt:'#633806',fc:'#F5C03D',glow:'rgba(245,192,61,0.5)'},
  Trust:{bg:'#EAF3DE',txt:'#27500A',fc:'#639922',glow:'rgba(99,153,34,0.4)'},
  Anticipation:{bg:'#FAECE7',txt:'#712B13',fc:'#D85A30',glow:'rgba(216,90,48,0.4)'},
  Surprise:{bg:'#FBEAF0',txt:'#72243E',fc:'#D4537E',glow:'rgba(212,83,126,0.4)'},
  Custom:{bg:'#F1EFE8',txt:'#444441',fc:'#888780',glow:'rgba(136,135,128,0.4)'}
};

var STATUS_LINES = {
  Angry: function(n){return n+' has the controls';},
  Sad: function(n){return n+' is at the wheel';},
  Fear: function(n){return n+' is in the chair';},
  Disgust: function(n){return n+' is driving';},
  Happy: function(n){return n+' is running HQ';},
  Trust: function(n){return n+' is steering';},
  Anticipation: function(n){return n+' is on the controls';},
  Surprise: function(n){return n+' just grabbed the wheel';},
  Custom: function(n){return n+' is driving';}
};

var selected = null;
var intensity = 5;
var logEntries = [];

function buildUI(){
  var container=document.getElementById('families');
  FAMILIES.forEach(function(f){
    var fs=FAM_STYLE[f];
    var emotions=EMOTIONS.filter(function(e){return e.family===f;});
    var block=document.createElement('div');
    block.className='fblock';
    var nameRow=document.createElement('div');
    nameRow.className='fname-row';
    var nameEl=document.createElement('span');
    nameEl.className='fname';
    nameEl.style.background=fs.bg;
    nameEl.style.color=fs.txt;
    nameEl.textContent=f;
    var count=document.createElement('span');
    count.className='fcount';
    count.textContent=emotions.length+' feeling'+(emotions.length>1?'s':'');
    nameRow.appendChild(nameEl);
    nameRow.appendChild(count);
    block.appendChild(nameRow);
    var chips=document.createElement('div');
    chips.className='chips';
    emotions.forEach(function(e){
      var c=document.createElement('div');
      c.className='chip';
      c.id='chip-'+e.id;
      c.textContent=e.label;
      c.style.setProperty('--chip-bg',e.fbg);
      c.style.setProperty('--chip-txt',e.ftxt);
      c.style.setProperty('--chip-shadow',e.fc+'80');
      c.style.setProperty('--chip-active',e.fc);
      c.onclick=function(){selectEmotion(e);};
      chips.appendChild(c);
    });
    block.appendChild(chips);
    container.appendChild(block);
  });
}

function selectEmotion(e){
  if(selected){
    var prev=document.getElementById('chip-'+selected.id);
    if(prev) prev.classList.remove('active');
  }
  selected=e;
  var chip=document.getElementById('chip-'+e.id);
  if(chip) chip.classList.add('active');
  var fs=FAM_STYLE[e.family];
  document.getElementById('preview-name').textContent=e.label;
  document.getElementById('preview-fam').textContent=e.family.toUpperCase()+' FAMILY';
  document.getElementById('preview-fam').style.color=fs.fc;
  var consoleEl=document.getElementById('console');
  consoleEl.style.setProperty('--fam-color',fs.fc);
  consoleEl.style.setProperty('--fam-glow',fs.fc);
  consoleEl.style.setProperty('--ring',fs.fc);
  consoleEl.style.setProperty('--glow',fs.glow);
  document.getElementById('screen-wrap').classList.add('lit');
  var img=document.getElementById('preview-img');
  var empty=document.getElementById('screen-empty');
  if(e.img){img.src=e.img;img.style.display='block';empty.style.display='none';}
  else{img.style.display='none';empty.style.display='flex';}
  document.getElementById('hq-status').textContent=STATUS_LINES[e.family](e.label);
  updatePips();
  updateGauge();
}

function updatePips(){
  var ac=intensity<=3?0:intensity<=6?1:intensity<=8?2:3;
  for(var i=0;i<3;i++){
    var pip=document.getElementById('p'+i);
    if(pip) pip.className='pip'+(i<ac?' on':'');
  }
}
function updateGauge(){
  var pct=(intensity/10)*100;
  document.getElementById('gauge-fill').style.width=pct+'%';
}
document.getElementById('intensity').addEventListener('input',function(){
  intensity=parseInt(this.value);
  document.getElementById('int-val').textContent=intensity;
  updatePips();
  updateGauge();
});

function getTime(){
  var d=new Date(),h=d.getHours(),m=d.getMinutes();
  var ap=h>=12?'pm':'am';h=h%12||12;
  return h+':'+(m<10?'0'+m:m)+ap;
}

function logIt(){
  if(!selected) return;
  var note=document.getElementById('note').value.trim();
  logEntries.unshift({e:selected,intensity:intensity,note:note,time:getTime()});
  document.getElementById('note').value='';
  renderLog();
}

function renderLog(){
  var list=document.getElementById('log-list');
  if(!logEntries.length){
    list.innerHTML='<div class="empty-log">No memories saved yet today.</div>';
    return;
  }
  list.innerHTML=logEntries.map(function(entry){
    var e=entry.e;
    var fs=FAM_STYLE[e.family];
    var thumb=e.img?'<img class="orb-thumb" src="'+e.img+'">'  :'';
    var note=entry.note?'<div class="orb-note">"'+entry.note+'"</div>':'';
    var style='--orb-color:'+e.fc+';--orb-bg:'+e.fbg+';--orb-shadow:'+e.fc+'33';
    return '<div class="memory-orb" style="'+style+'"><div class="orb-thumb-wrap">'+thumb+'</div><div class="orb-body"><div class="orb-top"><span class="orb-name">'+e.label+'</span><span class="orb-int">'+entry.intensity+'/10</span><span class="orb-time">'+entry.time+'</span></div>'+note+'</div></div>';
  }).join('');
}

buildUI();
updateGauge();
</script>
